{
  "name": "ai-agency-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/unit/*.test.ts\"",
    "cli": "node src/cli.ts",
    "serve": "node src/serve.ts",
    "typecheck": "tsc -p .",
    "test:db": "bash test/run-db-tests.sh",
    "demo": "node src/demo.ts",
    "demo:db": "bash scripts/setup-local-db.sh",
    "test:all": "npm run typecheck && npm test && npm run test:db",
    "acceptance": "node src/acceptance/run.ts"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
