# ============================================================================
# AI Agency OS – Umgebungsvariablen. Diese Datei enthält nur Platzhalter.
# Echte Werte gehören in die Umgebung des Servers (Vercel/Docker/Shell) – niemals ins Repository.
# Lokal testen ohne jeden Account: nur DASHBOARD_PASSWORD + DATABASE_URL + OWNER_ID setzen (siehe SETUP.md, „Demo-Modus“).
# ============================================================================

# --- Betriebsart ------------------------------------------------------------
# mock (Standard): alle Dienste laufen mit Testdaten, nichts Echtes wird gesendet/bezahlt/veröffentlicht.
# live: echte Adapter werden genutzt, sobald der jeweilige Schlüssel unten gesetzt ist; fehlt einer, bleibt dieser Dienst im Mock (sichtbar unter Einstellungen → Provider).
APP_MODE=mock
# Einzeln umschaltbar (mock|real): PROVIDER_PLACES, PROVIDER_CRAWLER, PROVIDER_RENDER, PROVIDER_AI, PROVIDER_PAYMENTS, PROVIDER_HOSTING
PROVIDER_CRAWLER=
# Konfigurationsordner (Preise, Agentur-Angaben, Scoring …). config.mock enthält ausgefüllte Testwerte für die Demo; config enthält bewusst Platzhalter.
CONFIG_DIR=config
# Ordner mit den Website-Vorlagen (Standard: templates)
TEMPLATES_DIR=

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
# Mindestens 12 Zeichen. Benutzername beim Login ist beliebig.
DASHBOARD_PASSWORD=
# Öffentliche Adresse des Dashboards (für Zahlungs- und Freigabelinks), HTTPS in Produktion
PUBLIC_BASE_URL=
# Nur hinter einem Proxy/Load-Balancer auf 1 setzen (nutzt X-Forwarded-For für die IP-Begrenzung)
TRUST_PROXY=0
# 1 = Wartungsprüfungen stündlich automatisch ausführen
MAINTENANCE_AUTORUN=0
# 1 = nach bestätigter Restzahlung automatisch veröffentlichen (Standard: Freigabe per Klick)
AUTO_DEPLOY=0

# --- Datenbank (Supabase/Postgres) ------------------------------------------
# Direkte Postgres-Verbindung (Supabase: Project Settings → Database → Connection string). Nur serverseitig.
DATABASE_URL=
# UUID deines Nutzers aus Supabase → Authentication → Users
OWNER_ID=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Externe Dienste (erst nötig, wenn du auf live umstellst) -----------------
# Lead-Suche (Google Places API (New))
GOOGLE_PLACES_API_KEY=
# Ohne GOOGLE_PLACES_API_KEY nutzt APP_MODE=live die keyfreie Quelle OpenStreetMap (Daten © OpenStreetMap-Mitwirkende, ODbL). PLACES_SOURCE=osm|google erzwingt eine Quelle.
PLACES_SOURCE=
# Kontakt-Adresse für den User-Agent gegenüber OpenStreetMap-Servern (Nutzungsrichtlinie), z. B. info@meine-agentur.de
OSM_CONTACT=
# WhatsApp Business Cloud API (Meta): Zugriffstoken und Telefonnummer-ID. Nur mit dokumentiertem Opt-in und freigegebenen Vorlagen nutzbar.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# KI für Gesprächseinstiege und Änderungswünsche
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_MODEL_MASS=
ANTHROPIC_MODEL_DEEP=
ANTHROPIC_MODEL_PREMIUM=
# Zahlungen (Test-Schlüssel zuerst: sk_test_…). Webhook-URL in Stripe: <PUBLIC_BASE_URL>/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# E-Mail-Versand (SMTP, z. B. dein Mail-Anbieter oder Resend/Brevo/Gmail-App-Passwort). Ohne diese Werte: Mock (Mails nur im Postausgang sichtbar, nichts wird verschickt).
SMTP_HOST=
# 587 = STARTTLS (Standard), 465 = verschlüsselt von Anfang an
SMTP_PORT=587
# 1 für Port 465
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
# Absender, z. B. Meine Agentur <info@meine-agentur.de>
SMTP_FROM=
# Veröffentlichung von Kundenseiten: ohne VERCEL_TOKEN werden sie nach HOSTING_DIR (Standard out/sites/) geschrieben
VERCEL_TOKEN=
VERCEL_TEAM_ID=
HOSTING_DIR=
# Mock-Hosting (Demo): Ordner für „veröffentlichte“ Testseiten, erreichbar unter /hosted/<name>/
MOCK_HOSTING_DIR=
# Chromium für den Browser-Test (QA) und die Tiefenprüfung; meist automatisch gefunden
CHROMIUM_PATH=

# --- Quellen der Akquise-Pipeline (siehe config/pipeline.json) ---
# OpenStreetMap: PUBLIC_DEMO (öffentliche Server, nur Demo/kleine Läufe) | LOCAL_EXTRACT (eigener Overpass/Nominatim auf Geofabrik-Extrakt) | COMMERCIAL_PROVIDER (Anbieter mit eigener URL + Schlüssel)
OSM_MODE=
OSM_OVERPASS_URL=
OSM_NOMINATIM_URL=
OSM_API_KEY=
OSM_CACHE_DIR=
# Optionale Websuche (Brave Search API) – nur für Firmen, bei denen eine Website fehlt. Ohne Schlüssel: keine Websuche (live) bzw. Mock.
BRAVE_SEARCH_API_KEY=
PROVIDER_WEBSEARCH=

# --- Lokale Demo (npm run demo:start) ----------------------------------------
# Optional: diese Zeilen in .env.local (steht in .gitignore) kopieren und ausfüllen. Ohne Datei gelten die Standardwerte.
# DASHBOARD_PASSWORD=<mindestens 12 Zeichen>
# PORT=3055
# DEMO_DB=agency_demo
# PGUSER=<postgres-benutzer>
# PGPASSWORD=<passwort, falls nötig>
