# Nur serverseitig verwenden, niemals committen.
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direkte Postgres-Verbindung (Supabase: Project Settings → Database → Connection string). Nur serverseitig.
DATABASE_URL=
# UUID deines Nutzers aus Supabase → Authentication → Users
OWNER_ID=
# Mindestens 12 Zeichen
DASHBOARD_PASSWORD=
# Zahlungen (optional, Test-Schlüssel zuerst: sk_test_…). Webhook-URL in Stripe: <PUBLIC_BASE_URL>/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Öffentliche Adresse des Dashboards (für Zahlungs- und Freigabelinks), HTTPS in Produktion
PUBLIC_BASE_URL=
# Deployment: ohne VERCEL_TOKEN werden Kundenseiten nach out/sites/ geschrieben
VERCEL_TOKEN=
VERCEL_TEAM_ID=
AUTO_DEPLOY=0
# Nur hinter einem Proxy/Load-Balancer auf 1 setzen (nutzt X-Forwarded-For für die IP-Begrenzung)
TRUST_PROXY=0
